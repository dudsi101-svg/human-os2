{
  "name": "dzik-os-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/inject-precache.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:helpers": "node --test scripts/test-error-utils.mjs scripts/test-exercise-filters.mjs scripts/test-exercise-parser.mjs scripts/test-food-utils.mjs scripts/test-messaging.mjs scripts/test-notifications-utils.mjs scripts/test-ocr-utils.mjs scripts/test-onboarding-utils.mjs scripts/test-series-utils.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
