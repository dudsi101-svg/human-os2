# Dzik OS — przykładowa konfiguracja środowiska.
# Skopiuj do .env i uzupełnij. NIGDY nie commituj prawdziwych sekretów.

# Środowisko: dev / staging / production
DZIK_ENV=dev

# Baza danych (SQLite lokalnie, PostgreSQL na produkcji)
DZIK_DATABASE_URL=sqlite:///data/dzik.db
# DZIK_DATABASE_URL=postgresql+psycopg2://dzik:HASLO@localhost:5432/dzik
POSTGRES_PASSWORD=zmien-mnie

# Łańcuch audytu Human OS (zawsze plik SQLite — patrz ADR-DZIK-002)
DZIK_AUDIT_DB=data/audit.db

# Pliki użytkowników (zdjęcia, PDF-y)
DZIK_UPLOAD_DIR=data/uploads
DZIK_MAX_UPLOAD_MB=20

# Sesje i logowanie
DZIK_SESSION_TTL_H=72
DZIK_LOGIN_MAX_ATTEMPTS=5
DZIK_LOGIN_LOCKOUT_MIN=15
DZIK_BCRYPT_ROUNDS=12

# CORS — tylko jeśli frontend serwowany z innej domeny niż API
# DZIK_CORS_ORIGINS=https://app.przyklad.pl

# Marka (konfigurowalna bez zmian w kodzie)
DZIK_BRAND_NAME=Dzik OS
DZIK_BRAND_COACH=Lubelski Dzik
DZIK_BRAND_ACCENT=#b8f339

# AI — domyślnie wyłączone; aplikacja w pełni działa bez AI.
DZIK_AI_ENABLED=false
