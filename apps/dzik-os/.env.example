# Dzik OS — przykładowa konfiguracja środowiska.
# Skopiuj do .env i uzupełnij. NIGDY nie commituj prawdziwych sekretów.

# Środowisko: dev / staging / production
DZIK_ENV=dev

# Baza danych (SQLite lokalnie, PostgreSQL na produkcji)
DZIK_DATABASE_URL=sqlite:///data/dzik.db
# DZIK_DATABASE_URL=postgresql+psycopg2://dzik:HASLO@localhost:5432/dzik
POSTGRES_PASSWORD=zmien-mnie

# Łańcuch audytu Human OS (zawsze plik SQLite — patrz ADR-DZIK-002)
DZIK_AUDIT_DB=data/audit.db

# Pliki użytkowników (zdjęcia, PDF-y)
DZIK_UPLOAD_DIR=data/uploads
DZIK_MAX_UPLOAD_MB=20
# Zdjęcia: EXIF/GPS usuwane, dłuższy bok ograniczany, rekompresja.
DZIK_MAX_IMAGE_PX=2560
DZIK_IMAGE_QUALITY=85
# Limity zdjęć na raport tygodniowy (liczba / łączny rozmiar).
DZIK_MAX_CHECKIN_PHOTOS=8
DZIK_MAX_CHECKIN_PHOTOS_TOTAL_MB=60
# Po ilu godzinach upload bez referencji (sierota) jest sprzątany.
DZIK_ORPHAN_FILE_TTL_H=24

# Szyfrowanie plików at-rest (AES-256-GCM). Wygeneruj:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# UWAGA: klucz przechowuj OSOBNO od kopii zapasowych — bez niego pliki są
# nie do odzyskania. Pusty = zapis jawny (ostrzeżenie w logu poza dev/test).
# DZIK_FILE_KEY=

# Kopie zapasowe: python -m dzik_os.backup (patrz docs/DEPLOYMENT.md §4a)
DZIK_BACKUP_DIR=data/backups
DZIK_BACKUP_KEEP=14

# Sesje i logowanie
DZIK_SESSION_TTL_H=72
DZIK_LOGIN_MAX_ATTEMPTS=5
DZIK_LOGIN_LOCKOUT_MIN=15
DZIK_BCRYPT_ROUNDS=12

# CORS — tylko jeśli frontend serwowany z innej domeny niż API
# DZIK_CORS_ORIGINS=https://app.przyklad.pl

# Marka (konfigurowalna bez zmian w kodzie)
DZIK_BRAND_NAME=Dzik OS
DZIK_BRAND_COACH=Lubelski Dzik
DZIK_BRAND_ACCENT=#b8f339

# AI — domyślnie wyłączone; aplikacja w pełni działa bez AI.
DZIK_AI_ENABLED=false

# Web Push (VAPID). Klucz prywatny generuje się sam przy pierwszym użyciu
# i jest trwale zapisywany pod tą ścieżką (na produkcji: wolumen /data).
DZIK_VAPID_KEY=data/vapid.pem
DZIK_PUSH_CONTACT=mailto:admin@example.com
# Strefa czasowa przypomnień harmonogramu.
DZIK_TZ=Europe/Warsaw
